<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Reports - Tuwaze</title>
    <link rel="stylesheet" href="css/main.css" />
    <link rel="stylesheet" href="css/auth.css" />
  </head>
  <body>
    <!-- Navigation -->
    <%- include("./partials/header.ejs") %>

    <!-- Reports Container -->
    <main>
      <div class="auth-container" style="max-width: 1000px;">
        <div class="auth-header">
          <h1>My Reports</h1>
          <p>View and manage your submitted reports.</p>
        </div>

        <% if (reports.length === 0) { %>
        <p>You have no reports yet. <a href="/report">Submit your first report</a></p>
        <% } else { %>
        <div class="reports-list">
          <% reports.forEach(report => { %>
          <div class="report-item">
            <div class="report-summary">
              <h3><%= report.title %></h3>
              <p><strong>Category:</strong> <%= report.category %></p>
              <p><strong>Status:</strong> <%= report.status %></p>
              <p><strong>Created:</strong> <%= new Date(report.created_at).toLocaleDateString() %></p>
              <p><strong>Media:</strong> <%= report.media_count %> files</p>
            </div>
            <div class="report-actions">
              <a href="/reports/<%= report.report_id %>/edit" class="btn-edit">Edit</a>
              <button class="btn-media" onclick="toggleMediaForm(<%= report.report_id %>)">Add Media</button>
            </div>
            <div class="media-form" id="media-form-<%= report.report_id %>" style="display: none;">
              <form method="POST" action="/reports/<%= report.report_id %>/media">
                <label for="file_url_<%= report.report_id %>">File URL:</label>
                <input type="url" id="file_url_<%= report.report_id %>" name="file_url" required />
                <label for="file_type_<%= report.report_id %>">File Type:</label>
                <select id="file_type_<%= report.report_id %>" name="file_type" required>
                  <option value="image">Image</option>
                  <option value="video">Video</option>
                </select>
                <button type="submit">Add Media</button>
              </form>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>
    </main>
    <!-- Footer -->
    <footer>
      <p>&copy; 2024 Tuwaze. Let's enlighten together.</p>
    </footer>

    <script>
      function toggleMediaForm(reportId) {
        const form = document.getElementById(`media-form-${reportId}`);
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
      }
    </script>
  </body>
</html>
