<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Tuwaze</title>
    <link rel="stylesheet" href="css/main.css">
    <link rel="stylesheet" href="css/dashboard.css">
</head>
<body>
    <%- include("./partials/header.ejs") %>

    <main>
        <h1>Dashboard</h1>

        <div class="stats-container">
            <div class="stat-card">
                <h3>Male Users</h3>
                <div class="number"><%= maleFemaleCount.male %></div>
            </div>
            <div class="stat-card">
                <h3>Female Users</h3>
                <div class="number"><%= maleFemaleCount.female %></div>
            </div>
        </div>

        <h2>All Users</h2>
        <ol>
            <% allUsers.forEach(user=>{%>
                <li><%= user.full_name %></li>
            <% }) %>
        </ol>
    </main>
</body>
</html>