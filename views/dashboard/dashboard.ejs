<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Tuwaze</title>
    <link rel="stylesheet" href="css/main.css">
    <link rel="stylesheet" href="css/dashboard.css">
</head>
<body>
    <%- include("../partials/header.ejs") %>

    <main>
        <h1>Dashboard</h1>

        <div class="stats-container">
            <div class="stat-card">
                <h3>Male Users</h3>
                <div class="number"><%= maleFemaleCount.male %></div>
            </div>
            <div class="stat-card">
                <h3>Female Users</h3>
                <div class="number"><%= maleFemaleCount.female %></div>
            </div>
            <div class="stat-card">
                <h3> Tips Submitted</h3>
                <div class="number"><%= allTips.length %></div>
            </div>
        </div>
        <section>
        <h2>All Users</h2>
        <table>
            <thead>
                <td>User Name</td>
                <td>Phone Number</td>
                <td>Email</td>
                <td>Gender</td>
            </thead>
            <% allUsers.forEach(user=>{%>
                <tr style="color: <%= user.gender=="Male"? "black":"pink"%>" >
                    <td><%= user.full_name %></td>
                    <td><%= user.phone_number %></td>
                    <td><%= user.email %></td>
                    <td><%= user.gender%></td>
                </tr>
               
            <% }) %>
        </table>
            
       
        </section>
        <section>
            <h2>Anonymous Tips</h2>
            <ul>
            <% allTips.forEach(tip => { %>
                <li>
                    <strong>Type:</strong> <%= tip.category %><br>
                    <strong>Description:</strong> <%= tip.description %><br>
                    <strong>Date:</strong> <%= new Date(tip.created_at).toLocaleString() %> <br>
                    <strong>Status:</strong> <%= tip.status %>
                </li>
            <% }) %>
        </section>
    </main>
</body>
</html>
